# Shell scripts and git hooks must keep LF line endings (core.autocrlf would break the shebang)
*.sh            text eol=lf
*.command       text eol=lf
tools/hooks/*   text eol=lf
# Windows batch files
*.bat           text eol=crlf

# Keep hashed extension sources identical in Windows and WSL.
firmware/patch_src/sysex_split.*       text eol=lf
firmware/patch_src/sysex_split_glue.S  text eol=lf
firmware/patch_src/test_sysex_split.c  text eol=lf
