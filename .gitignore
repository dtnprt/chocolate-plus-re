# Third-party / copyrighted material lives outside this repo in ../third-party (vendor apps, decompiled
# sources, JieLi SDK + toolchains, stock firmware and its disassembly, vendor tools, manuals, photos).

# Firmware binaries: our builds are the stock M-VAVE firmware with patches, i.e. they contain vendor code.
# Build them from the original M-VAVE firmware 012 with firmware/build.py; local builds live in the parent repo (../firmware).
*.fwsc
*.ufw
firmware/out/
_archive/

# Build outputs / caches
android/build/
__pycache__/
*.pyc

# Assembler intermediates (regenerate with firmware/patch_src/asm_greet.sh)
*.o
firmware/patch_src/*.elf

# Claude Code local settings
.claude/settings.local.json
